# Copy this file to .env and fill in what you need. .env is never committed.

# Leave empty to run without a login on your Mac. Always set it on a public server.
APP_PASSWORD=

# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Needed later for AI recommendations, food estimates and chat.
OPENAI_API_KEY=
